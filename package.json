{
  "name": "ali-agent-kit",
  "version": "0.1.0",
  "description": "Shared skills (and more) for Claude Code, GitHub Copilot CLI and Codex CLI — installed and synced over npm.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ali-agent-kit": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pravbeseda/ali-agent-kit.git"
  },
  "bugs": {
    "url": "https://github.com/pravbeseda/ali-agent-kit/issues"
  },
  "homepage": "https://github.com/pravbeseda/ali-agent-kit#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "validate": "node bin/cli.js validate",
    "check": "npm run validate && npm test",
    "prepublishOnly": "npm run check",
    "sync": "node bin/cli.js install"
  },
  "keywords": [
    "claude-code",
    "codex",
    "copilot",
    "skills",
    "agent",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  }
}
